{"nodes": [{"id": "dgx_spark_multi_model_runtime_research_doc", "label": "DGX Spark Multi-Model Runtime Research", "file_type": "document", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ent_dgx_spark", "label": "DGX Spark", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Why the Spark says nearly 120 GB is in use", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "128 GB LPDDR5X unified memory; 273 GB/s bandwidth; supports models up to 200B params (capacity statement)"}, {"id": "ent_unified_memory_128gb", "label": "128 GB Unified Memory (LPDDR5X)", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Why the Spark says nearly 120 GB is in use", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Single pool shared by CPU, GPU, OS, filesystem cache, containers, weights, KV caches; 273 GB/s fabric; ~119-121 GiB commonly available to model processes", "rationale": "Not 128 GB dedicated VRAM plus separate host RAM, so multiple resident servers contend for the same pool and bandwidth"}, {"id": "ent_gb10", "label": "GB10 Superchip", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Ollama: the easiest automatic shelf, with tradeoffs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Compute capability 12.1 (Blackwell)"}, {"id": "ent_vllm", "label": "vLLM", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Why use vLLM at all?", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Inference server: NVFP4 paths on Blackwell, continuous batching, explicit KV caches, OpenAI-compatible API, reasoning/tool parsers, MTP and DFlash speculative decoding", "rationale": "Chosen as the inference server for the exact optimized checkpoints, not as the model itself"}, {"id": "ent_ollama", "label": "Ollama", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Ollama: the easiest automatic shelf, with tradeoffs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Loads on request, keep_alive default 5 min, unloads idle models when memory is short; separate model store"}, {"id": "ent_lm_studio", "label": "LM Studio", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 LM Studio and LM Link: the easiest Windows-controlled shelf", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Models stored in ~/.lmstudio/models; JIT loading, idle TTL, Auto-Evict; REST model management"}, {"id": "ent_llmster", "label": "llmster (LM Studio headless server)", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 LM Studio and LM Link: the easiest Windows-controlled shelf", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Officially supported headless LM Studio server on DGX Spark"}, {"id": "ent_lm_link", "label": "LM Link", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 LM Studio and LM Link: the easiest Windows-controlled shelf", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Preview; encrypted Tailscale-based link letting Windows LM Studio Desktop use Spark llmster models remotely"}, {"id": "ent_litellm", "label": "LiteLLM", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Can Hermes simply select either current entry?", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "ODS container ods-litellm on 127.0.0.1:4000; static routing catalog, not a live residency display"}, {"id": "ent_hermes", "label": "Hermes Agent", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Can Hermes simply select either current entry?", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ent_open_webui", "label": "Open WebUI", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Open WebUI is a frontend, not the model host", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend that proxies to Ollama, LM Studio or LiteLLM; does not remove backend load time or memory needs"}, {"id": "ent_sglang", "label": "SGLang", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Ollama: the easiest automatic shelf, with tradeoffs", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ent_spark_fast", "label": "spark-fast route / vllm-spark-fast service", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 2026-08-15 Live Memory Measurements And Optimization Targets", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Stable LiteLLM route to Qwen 3.6 35B A3B NVFP4 vLLM; 18 GiB explicit KV, 0.72 admission guard, ~48.2 GiB GPU allocation, 262,144 context; container vllm-spark-fast; 127.0.0.1:8000; network alias spark-fast; image ghcr.io/miaai-lab/mia-vllm-gb10-linear-b12x pinned by digest"}, {"id": "ent_qwen_3_6_35b_a3b", "label": "Qwen3.6 35B A3B NVFP4", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Why \u201c35B at 4-bit equals about 17 GB\u201d is incomplete", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "35B total / ~3B active, MTP module, vision encoder, 262,144 native context; Unsloth repo ~26.5 GB; works on 32 GB GPU"}, {"id": "ent_qwen_3_6_27b", "label": "Qwen3.6 27B NVFP4", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Qwen 27 Optimized MTP-3 Profile", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Dense 27B; NVIDIA NVFP4 card ~2.5x reduction vs 16-bit; ~21.9 GB target repo"}, {"id": "ent_dflash", "label": "DFlash speculative decoding", "file_type": "rationale", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Why use vLLM at all?", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "z-lab/Qwen3.6-27B-DFlash 2B BF16 draft, 3.46 GB"}, {"id": "ent_mtp", "label": "MTP (Multi-Token Prediction) speculative decoding", "file_type": "rationale", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Qwen 27 Optimized MTP-3 Profile", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ent_nemotron_3_nano_omni", "label": "Nemotron 3 Nano Omni", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Can three or four models stay loaded?", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4; 31B total/~3B active; BF16 62 GB, FP8 33 GB, NVFP4 21 GB; 256K context; Ollama tag nemotron3:33b; Container vllm-nemotron3-omni; raw API 127.0.0.1:8004; ODS http://nemotron3-omni:8000/v1; text, image, audio, video"}, {"id": "ent_gemma_4", "label": "Gemma 4", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Can three or four models stay loaded?", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ent_gemma_4_26b_a4b", "label": "Gemma 4 26B A4B", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Can three or four models stay loaded?", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "25.2B total / 3.8B active; 256K context; Ollama package 18 GB; nvidia/Gemma-4-26B-A4B-NVFP4"}, {"id": "ent_gemma_4_31b", "label": "Gemma 4 31B", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Can three or four models stay loaded?", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "30.7B dense; Ollama package 20 GB"}, {"id": "ent_nvfp4", "label": "NVFP4", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Why \u201c35B at 4-bit equals about 17 GB\u201d is incomplete", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Only linear-operator weights/activations in transformer blocks are NVFP4"}, {"id": "ent_flashinfer", "label": "FlashInfer", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Qwen 27 Optimized MTP-3 Profile", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ent_tailscale", "label": "Tailscale", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 LM Studio and LM Link: the easiest Windows-controlled shelf", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dgx_spark_multi_model_runtime_research_model_lifecycle_states", "label": "Model lifecycle states (Downloaded/Registered/Loaded/Healthy/Selected)", "file_type": "rationale", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Bottom line", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates disk storage, catalog registration, memory residency, health and routing so a menu entry is not mistaken for a running server"}, {"id": "dgx_spark_multi_model_runtime_research_serving_allocation_vs_weights", "label": "120 GB observation is serving allocation, not weights", "file_type": "rationale", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Bottom line", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Original Qwen 27B profile allowed 84% of pool; vLLM turned remainder into 74.1 GiB KV cache", "rationale": "High nvidia-smi use reflects near-exclusive server configuration (gpu_memory_utilization), not quantized weight size"}, {"id": "dgx_spark_multi_model_runtime_research_four_bit_lower_bound", "label": "35B at 4-bit lower-bound arithmetic", "file_type": "rationale", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Why \u201c35B at 4-bit equals about 17 GB\u201d is incomplete", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "35B x 4 bits = 17.5e9 bytes ~16.3 GiB lower bound", "rationale": "Real runtime adds non-4-bit tensors, draft model, KV cache, activations, CUDA graphs and fragmentation"}, {"id": "dgx_spark_multi_model_runtime_research_vllm_switch_cost", "label": "vLLM model switch startup sequence", "file_type": "rationale", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Why vLLM switching takes time", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "8 steps: drain, release memory, start container, read shards, construct model+draft, profile/allocate KV, compile/graph capture, open endpoints; NVIDIA uses 900 s health wait"}, {"id": "dgx_spark_multi_model_runtime_research_qwen27_compile_cache_gap", "label": "Qwen 27B compose lacks persisted vLLM compile cache", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Why vLLM switching takes time", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Qwen 35B persists /root/.cache/vllm but Qwen 27B only Triton cache, so recreation behaves like a cold start"}, {"id": "dgx_spark_multi_model_runtime_research_litellm_http_500_incident", "label": "One-time LiteLLM HTTP 500 on stopped upstream", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Can Hermes simply select either current entry?", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LiteLLM knew the model group name but upstream vLLM container was stopped; selection does not start containers"}, {"id": "dgx_spark_multi_model_runtime_research_qwen27_mtp3_profile", "label": "Qwen 27 optimized MTP-3 profile (qwen27-dflash legacy route)", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Qwen 27 Optimized MTP-3 Profile", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "44 GiB FP8 KV, 0.65 guard, 71.3 GiB GPU allocation (from 103.2), model state 20.8 GiB, 1,241,888 KV tokens = 4.74 x 262K; FlashInfer, 8,192 batched tokens, native MTP-3; NVFP4 layers fall back to Marlin", "rationale": "Legacy route name kept to avoid breaking LiteLLM and saved Hermes sessions though method is now MTP-3, not DFlash"}, {"id": "dgx_spark_multi_model_runtime_research_nemotron_omni_optimized_profile", "label": "Nemotron Omni 12 GiB KV profile", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Nemotron 3 Nano Omni", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "0.70 guard, 12 GiB KV; GPU allocation 90.6 -> 43.2 GiB; available memory 22 -> 67 GiB; 838,432 KV tokens", "rationale": "Shrinking KV improves capacity/coexistence, not single-stream decode speed"}, {"id": "dgx_spark_multi_model_runtime_research_performance_first_architecture", "label": "Performance-first baseline architecture", "file_type": "rationale", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Performance-first baseline \u2014 recommended for Hermes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Clients -> Hermes + gateway -> LiteLLM stable route -> one healthy large runtime; shared NVMe shelf and persistent compile caches", "rationale": "Makes switching safe and understandable; cannot eliminate physical model-load delay"}, {"id": "dgx_spark_multi_model_runtime_research_one_large_worker_rule", "label": "One large vLLM worker at a time rule", "file_type": "rationale", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Performance-first baseline \u2014 recommended for Hermes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-context vLLM profiles for 3-4 large models cannot be co-resident in 128 GB; 0.72 and 0.84 instances must not run together"}, {"id": "dgx_spark_multi_model_runtime_research_switch_command", "label": "Single switch command (stop, wait, start, health, smoke test, reroute)", "file_type": "rationale", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Performance-first baseline \u2014 recommended for Hermes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Route changes only after /health and identity/tool smoke tests succeed"}, {"id": "dgx_spark_multi_model_runtime_research_convenience_first_alternative", "label": "Convenience-first alternative (Ollama or LM Studio, choose one)", "file_type": "rationale", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Convenience-first alternative", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JIT loading and idle eviction for browsing models, at the cost of different formats and performance path; avoid duplicate stores"}, {"id": "dgx_spark_multi_model_runtime_research_model_test_order", "label": "Model order for requested tests", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Model order for the requested tests", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Qwen 35B baseline; Qwen 27B DFlash comparison; Nemotron Omni on demand; Gemma 4 26B A4B before 31B"}, {"id": "dgx_spark_multi_model_runtime_research_nemotron_name_confusion", "label": "Nemotron 3.5 vs Nemotron 3 Nano Omni naming note", "file_type": "concept", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Model order for the requested tests", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dgx_spark_multi_model_runtime_research_doc", "label": "DGX Spark Multi-Model Runtime Research", "file_type": "document", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dgx_spark_multi_model_runtime_research_doc", "label": "DGX Spark Multi-Model Runtime Research", "file_type": "document", "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "dgx_spark_multi_model_runtime_research_doc", "target": "ent_dgx_spark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DGX Spark Multi-Model Runtime Research.md", "source_location": "\u00a7 Why the