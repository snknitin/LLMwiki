{"nodes": [{"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_doc", "label": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial", "file_type": "document", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_recipe_pin", "label": "GLM recipe pinned commit 0f49cfd", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 What this recipe is", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Repo MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks @0f49cfdbaa13; model rev 25a44fd; drafter rev dc77ff1; image ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-instanttensor; served GLM-5.3-Flash-EXL3; TP2; port 8100"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_dflash_850k_baseline", "label": "DFlash/850K baseline profile", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Memory and coexistence limits", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "DFlash2 k=7, 850K ctx, GMU 0.87 (121.69x0.87=105.87 GiB/node), 14.15 GiB KV, capacity 880,357 tokens; 4 seqs; boot 230s + 77s warm-up", "rationale": "Upstream 0.85 left 12.25 GiB KV vs 13.46 GiB required; max length fell to 680,960"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_mtp_850k_accepted", "label": "Accepted MTP k=2 850K profile (GMU 0.84)", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Memory and coexistence limits", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "SPEC_METHOD=mtp MTP_TOKENS=2, GMU 0.84, auto KV sizing 10.29 GiB, 1.46x capacity; idle ~5.0 GiB head / 8.6 GiB worker; 790,022-token retrieval in 577s; C1/C2/C4 23.717/39.036/59.207 tok/s", "rationale": "Keeps head low-water above 3 GiB floor; GMU 0.87 MTP crossed floor; 14 GiB manual KV left 2.6 GiB MemAvailable; avoids CC BY-NC-ND drafter"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_dflash_500k_profile", "label": "DFlash/500K profile (GMU 0.86)", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 16 \u2014 Optional, separately recorded MTP and 500K adaptations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "500K needs 10.98 GiB KV; GMU 0.84 gave 10.41 GiB (fail); 0.86 gave 12.69 GiB, 1.15x concurrency"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_instanttensor_fix", "label": "InstantTensor loader budget fix", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 7 \u2014 Apply the validated startup fix and launch the 850K baseline", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "INSTANTTENSOR_BUFFER_SIZE=536870912; largest tensor 1,268,776,960 B; MTP also needs INSTANTTENSOR_MAX_FREE_MEM_USAGE=0.99 (budget was 937,799,680 B)", "rationale": "Default staging allowance is half of free memory, too small at MTP load point; 0.99 only changes upper-bound check"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_exclusive_node_policy", "label": "Exclusive both-node policy for GLM", "file_type": "rationale", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Memory and coexistence limits", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Stop spark-fast, LM Studio, Qwen, DeepSeek, sparkDash for first boot; no downloads/indexing during inference", "rationale": "256K prefill at GMU 0.87 once hit zero MemAvailable and crashed head"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_api_key", "label": "Shared frontier API key", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 2 \u2014 Create or reuse the shared API key", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "$HOME/.config/frontier/api-key, mode 600, openssl rand -hex 32"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_probe_suite", "label": "frontier-model-probe.py qualification suite", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 8a \u2014 Start a persistent qualification record", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "$HOME/ai/tools/frontier-model-probe.py init/identity/chat/tool/vision/context/concurrency/compare; results ~/frontier-results/<profile>/<UTC>/; vision fixture sha256 0c0b5e38...; markers QUALITY_TEST_OK, TOOL_CALL_OK (get_weather Bengaluru), VISION_TEST_OK, ORANGE-427"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_context_ladder", "label": "GLM context ladder", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 13 \u2014 Run the context ladder", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Fillers 30K,100K,250K,490K,790K; max-tokens 64; timeout 7200"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_perf_results", "label": "GLM local performance results", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 What the completed GLM performance tests mean", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "DFlash/850K C1/C2/C4 23.826/34.136/47.510; MTP/850K 21.700/39.730/55.196; v2 18.741/29.457/31.421; DFlash/500K 24.098/32.260/49.242; structured MTP decode 18.966->24.169 tok/s (+27.4%)"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_named_profiles", "label": "API-key-safe named GLM profiles", "file_type": "rationale", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 16a \u2014 Create API-key-safe named configuration profiles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "~/.config/frontier/glm53-profiles/{dflash-850k,mtp-850k,dflash-500k,accepted}.env mode 600", "rationale": "Repo ignores .env but not .env.* copies containing VLLM_API_KEY"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_evidence_suite", "label": "Step 16e shared evidence suite", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 16e \u2014 Shared evidence suite for each adaptation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Derives PROFILE/MAX_CONTEXT/FILLERS from running container env; checks .env match"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_spark_fast_rollback", "label": "Stop GLM and restore spark-fast", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 15 \u2014 Stop and restore `spark-fast`", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "./start.sh stop; check ports 8100/29521; spark-model use qwen35; curl :8000/v1/models"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_dflash_vs_mtp_faq", "label": "DFlash acceptance vs prose speed", "file_type": "rationale", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Performance, adaptation, and results FAQ", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Repo 62-65 tok/s is structured high-acceptance DFlash; ordinary chat ~18.1, prose ~27.1, MTP k=2 ~24.6", "rationale": "Speculative throughput depends on draft acceptance; prose accepts fewer later drafts"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_jit_warnings", "label": "TileLang/Triton JIT latency warnings", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 16e \u2014 Shared evidence suite for each adaptation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Latency warnings, not failures"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_soak_requirement", "label": "Long-generation and 48h soak requirement", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Acceptance checklist", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "25K-output generation, 24h mixed, 48h soak still outstanding"}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_glm_containers", "label": "GLM containers glm53-exl3-head / glm53-exl3-worker", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 7 \u2014 Apply the validated startup fix and launch the 850K baseline", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ent_instanttensor", "label": "InstantTensor loader", "file_type": "concept", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_doc", "label": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial", "file_type": "document", "source_file": "DGX Spark Dual-Node GLM 5.3 Flash EXL3 Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dgx_spark_dual_node_glm_5_3_flash_exl3_tutorial_doc