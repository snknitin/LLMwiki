{"nodes": [{"id": "dgx_spark_model_installation_and_switching_guide_doc", "label": "DGX Spark Model Installation And Switching Guide", "file_type": "document", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ent_qwen_3_6_35b_a3b", "label": "Qwen 3.6 35B-A3B NVFP4", "file_type": "concept", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Default always-on Hermes/tool model served as spark-fast"}, {"id": "ent_ling_3_flash", "label": "Ling 3.0 Flash", "file_type": "concept", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Experimental ~120 GB MoE on custom SGLang"}, {"id": "ent_deepseek_v4_flash", "label": "DeepSeek V4 Flash (SparkInfer)", "file_type": "concept", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "0xSero/deepseek-v4-flash-0731-spark-sparkinfer; needs >=250-300 GB free"}, {"id": "ent_minimax_h3", "label": "MiniMax H3", "file_type": "concept", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dgx_spark_model_installation_and_switching_guide_model_order", "label": "Single-Spark model installation order", "file_type": "rationale", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": "\u00a7 The model order for this Spark", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "1 Qwen 3.6 35B spark-fast, 2 Qwen 3.6 27B DFlash, 3 Nemotron 3 Nano Omni, 4 DeepSeek V4 Flash SparkInfer, 5 Ling 3.0 Flash", "rationale": "Every extra model consumes disk; add one at a time after previous passes"}, {"id": "dgx_spark_model_installation_and_switching_guide_qwen27_dflash_service", "label": "qwen27-dflash controlled compose service", "file_type": "concept", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": "\u00a7 Step 18 \u2014 Prepare the Qwen 27B DFlash service", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "~/ai/services/qwen27-dflash; port 8001; image vllm/vllm-openai:nightly-aarch64 pinned digest; GMU 0.65, 44G KV, 262,144 ctx, 4 seqs; dflash num_speculative_tokens 10; CUTE_DSL_ARCH sm_121a", "rationale": "Replaces upstream host networking/--privileged/mutable nightly with shared cache, private ODS net, loopback API, pinned digest"}, {"id": "dgx_spark_model_installation_and_switching_guide_revision_fix", "label": "LocalEntryNotFoundError revision repair", "file_type": "concept", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": "\u00a7 One-time repair if you saw `LocalEntryNotFoundError`", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Record MODEL_REVISION/DRAFT_REVISION in model-revisions.env; add --revision; HF offline mode"}, {"id": "dgx_spark_model_installation_and_switching_guide_additional_model_rules", "label": "Rules for every additional model", "file_type": "rationale", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": "\u00a7 Step 22 \u2014 Rules for every additional model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Stop running model; check memory/disk; ~/src checkout with commit; ~/ai/services/<profile>; reuse HF cache; unique names/ports; RESTART_POLICY=no; test raw/LiteLLM/Hermes/tools"}, {"id": "dgx_spark_model_installation_and_switching_guide_spark_model_lanes", "label": "spark-model lane table", "file_type": "concept", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": "\u00a7 Step 23 \u2014 Daily model operations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "qwen35 (spark-fast), qwen27-dflash, nemotron3-omni (131,072 ctx 12 GiB KV), nemotron35-lightning (LM Studio 65,536)"}, {"id": "dgx_spark_model_installation_and_switching_guide_storage_ownership", "label": "Model store ownership rules", "file_type": "concept", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": "\u00a7 Step 23 \u2014 Daily model operations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "HF ~/.cache/huggingface; NIM ~/.cache/nim; LM Studio ~/.lmstudio/models; services ~/ai/services; sources ~/src; runs ~/runs; secrets ~/.config/dgx-spark/secrets.env"}, {"id": "dgx_spark_model_installation_and_switching_guide_hermes_model_refresh", "label": "Hermes discover_models refresh", "file_type": "concept", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": "\u00a7 Refresh newly installed Ollama and LM Studio models in Hermes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "discover_models true for desktop-ollama and spark-lmstudio; hermes model --refresh; /model --refresh in Telegram/Discord"}, {"id": "dgx_spark_model_installation_and_switching_guide_tailscale_serve_lmstudio", "label": "Tailscale Serve for Spark LM Studio", "file_type": "concept", "source_file": "DGX Spark Model Installation And Switching Guide.md", "source_location": "\u00a7 Refresh newly installed Ollama and LM Studio models in Hermes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "tailscale serve --bg --https=8443 http://127.0.0.1:1234 -> https://spark-07a8.tail4a1242.ts.net:8443/v1; never Funnel"}, {