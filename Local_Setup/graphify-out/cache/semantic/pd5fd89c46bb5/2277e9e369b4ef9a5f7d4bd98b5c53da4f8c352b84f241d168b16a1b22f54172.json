{"nodes": [{"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_doc", "label": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial", "file_type": "document", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ent_engram", "label": "DeepSeek Engram", "file_type": "concept", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Native shards 47 and 48 plus index (~190 GiB)"}, {"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_recipe_definition", "label": "DeepSeek V4.1 Flash EXL3 2x Spark Recipe", "file_type": "concept", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": "\u00a7 What this recipe is", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "Repo MiaAI-Lab/DeepSeek-v4.1-Flash-EXL3-2x-DGX-Sparks @8404ac7; checkpoint Mia-AiLab/DeepSeek-V4.1-Flash-EXL3-2.9bpw; image ghcr.io/miaai-lab/deepseek-v4.1-flash-exl3-2x-dgx-sparks:2.9bpw; TP2; DSpark k=3; 600,000 ctx; 2 seqs; KV 2.5 GiB/rank; NFSv4 weights; port 8100"}, {"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_memory_coexistence_limits", "label": "DeepSeek Memory And Coexistence Limits", "file_type": "rationale", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Memory and coexistence limits", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "99.5 GiB weights/rank; 2.5 GiB KV; 5-7 GiB CUDA/NCCL; ~9 GiB OS; 4.07-4.21 GiB avail after warm-up; 2.1 GiB after 601K prefill; 3 GiB KV died ~470K", "rationale": "Strictly exclusive: both Sparks belong to model; layer services back one at a time"}, {"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_source_staging_387gib", "label": "387 GiB Source Set Staging", "file_type": "concept", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 6 \u2014 Stage the approximately 387 GiB source set", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "~197 GiB 39 EXL3 shards + ~190 GiB Engram; resumable; needs 450 GiB free on FirstSpark"}, {"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_baseline_env_values", "label": "Baseline .env Values", "file_type": "concept", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 4 \u2014 Configure only cluster-specific substitutions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "GPU_MEM_UTIL 0.88; KV_CACHE_MEMORY_BYTES 2684354560; MAX_NUM_BATCHED_TOKENS 1536; LONG_PREFILL 1280; WEIGHT_SYNC nfs; DSV41_MEM_GUARD 0"}, {"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_host_side_tests", "label": "Host-Side Source Tests", "file_type": "concept", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 8 \u2014 Run host-side source tests before GPU launch", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "test_memory_log, test_engram_layout, test_engram_src, test_numeric_config; chat-template parity 19/19 inside image"}, {"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_safe_bringup_131k", "label": "Safe 131K Bring-Up Before 600K", "file_type": "rationale", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 9 \u2014 Safe bring-up, then the recipe-faithful baseline", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prove image/checkpoint/NFS/DSpark/vision at 131K before narrow-margin 600K; 131K is adapted, not faithful"}, {"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_saved_results", "label": "Saved DeepSeek Results", "file_type": "concept", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Saved DeepSeek result status after the raw concurrency gate", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "131K: 29.564 quality tok/s, 120,019 prompt, C1/C2/C4 34.153/34.875/34.803; 600K: 29.989, 580,019 prompt, 34.477/50.746/47.014"}, {"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_service_layering", "label": "Add Services Back One Layer At A Time", "file_type": "concept", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Step 16 \u2014 Add services back one layer at a time", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "LiteLLM only -> standalone Hermes -> sparkDash last"}, {"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_blocked_adaptations", "label": "Initially Blocked Adaptations", "file_type": "rationale", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": "\u00a7 Keep these blocked initially", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "cooperative MoE, abliterated overlay, start.sh pack, ZFS replication, DSV41_MEM_GUARD=1; SPEC_METHOD=none frees ~3.5 GiB", "rationale": "Each changes storage/model behavior and needs separate validation"}, {"id": "dgx_spark_dual_node_deepseek_v4_1_flash_exl3_tutorial_litellm_promotion", "label": "DeepSeek LiteLLM Promotion", "file_type": "concept", "source_file": "DGX Spark Dual-Node DeepSeek V4.1 Flash EXL3 Tutorial.md", "source_location": "\u00a7 LiteLLM and Hermes promotion", "source_url": null, "captured_at": null, "author": null, "contributor": null, "notes": "model_name deepseek41-flash; openai/DeepSeek-v4.1-Flash-EXL3; api_base http://192.168.0.101:81